# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudflare Turnstile public site key (optional locally; use with the Pages Function)
VITE_TURNSTILE_SITE_KEY="YOUR_TURNSTILE_SITE_KEY"
# Configure TURNSTILE_SECRET_KEY in Cloudflare Pages Functions environment variables only.
# Never put the secret key in a VITE_ variable or commit it to source control.

# Firebase Web App config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY="AIzaSyAwcNhI9CrOtDEevIji9ReAglkPuNf-dkQ"
VITE_FIREBASE_AUTH_DOMAIN="authenticationwebnovasolutions.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID="authenticationwebnovasolutions"
VITE_FIREBASE_STORAGE_BUCKET="authenticationwebnovasolutions.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="257722078505"
VITE_FIREBASE_APP_ID="1:257722078505:web:47d66007711fc4101d9338"
VITE_FIREBASE_MEASUREMENT_ID="G-RYECWWP928"

# EmailJS (configure these in your hosting provider's environment settings)
VITE_EMAILJS_PUBLIC_KEY="YOUR_EMAILJS_PUBLIC_KEY"
VITE_EMAILJS_SERVICE_ID="YOUR_EMAILJS_SERVICE_ID"
VITE_EMAILJS_OTP_TEMPLATE_ID="YOUR_OTP_TEMPLATE_ID"
VITE_EMAILJS_WELCOME_TEMPLATE_ID="YOUR_WELCOME_TEMPLATE_ID"
VITE_EMAILJS_FEEDBACK_TEMPLATE_ID="YOUR_FEEDBACK_TEMPLATE_ID"
VITE_EMAILJS_CONTACT_TEMPLATE_ID="YOUR_CONTACT_TEMPLATE_ID"
